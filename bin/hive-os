#!/usr/bin/env python3
"""Hive OS compatibility wrapper for the historical `hive-os` command.

This launcher is a compatibility wrapper kept for users/scripts that invoke
`hive-os`. It delegates unchanged to the canonical `bin/hive` dispatcher.

Classification: COMPATIBILITY WRAPPER -> MODERN CANONICAL
"""

import os
import subprocess
import sys
from pathlib import Path

repo_root = Path(__file__).resolve().parent.parent
hive = repo_root / "bin" / "hive"
cmd = [sys.executable, str(hive)] + sys.argv[1:]
result = subprocess.run(cmd, cwd=str(repo_root), env=os.environ.copy())
sys.exit(result.returncode)
