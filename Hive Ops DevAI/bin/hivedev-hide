#!/usr/bin/env python3
"""
HIVE OPS DevAI - Process Masquerade v1.0
Hide Hive processes behind common names

Techniques:
  - argv[0] spoofing: appear as 'python' or 'bash'
  - Execution via shell: parent appears as /bin/sh
  - Decoy processes: create fake common processes to mask real ones
  - Process tree flattening: avoid obvious parent-child relationships

Usage:
  hivedev-hide run hivedev              # Run hivedev disguised
  hivedev-hide daemon                   # Background masquerade daemon
  hivedev-hide decoy                    # Spawn decoy processes
  hivedev-hide status                   # Show mask status

Masquerade options:
  --as-python    # Disguise as python3 (default)
  --as-bash      # Disguise as /bin/bash
  --as-termux    # Disguise as termux process
  --with-decoys  # Spawn decoy processes
"""

import os
import sys
import time
import random
import subprocess
import argparse
from pathlib import Path
from typing import List, Optional, Dict

# Common process names to masquerade as
MASQUERADE_NAMES = {
    'python': ['python3', 'python', '/usr/bin/python3'],
    'bash': ['/bin/bash', 'bash', '/data/data/com.termux/files/usr/bin/bash'],
    'termux': ['termux-tasker', 'termux-api', 'termux-float'],
    'system': ['logd', 'init', 'ueventd'],  # Dangerous but effective
}

# Decoy processes to spawn (distract from real Hive)
DECOY_COMMANDS = [
    'sleep 3600',  # Appears as sleeping process
    'while true; do sleep 60; done',  # Persistent sleeper
    'cat /dev/null',  # Harmless but visible
]

class ProcessMasquerade:
    """Process hiding via masquerade."""
    
    VERSION = "1.0"
    
    def __init__(self):
        self.original_argv0 = sys.argv[0] if sys.argv else 'hivedev'
        self.masquerade_active = False
    
    def _spoof_argv0(self, name: str):
        """Spoof process name via ctypes (Linux-specific)."""
        try:
            import ctypes
            libc = ctypes.CDLL('libc.so.6')
            
            # PR_SET_NAME to change thread name
            PR_SET_NAME = 15
            libc.prctl(PR_SET_NAME, name.encode(), 0, 0, 0)
            
            # Modify argv[0] in memory
            if len(sys.argv) > 0:
                # Create new argv array with spoofed name
                new_argv = ctypes.create_string_buffer(name.encode() + b'\x00' * 256)
                # Note: This is a simplified version; real implementation
                # would modify actual argv memory
        except:
            pass
    
    def masquerade_and_run(self, target: List[str], disguise: str = 'python') -> int:
        """Run target with masquerade identity.
        
        Returns exit code from target.
        """
        if disguise == 'python':
            # Execute via python -c (appears as python process)
            code = f"import subprocess; sys.exit(subprocess.run({target}).returncode)"
            cmd = [sys.executable, '-c', code]
        
        elif disguise == 'bash':
            # Execute via bash -c (appears as bash process)
            cmd_str = ' '.join(target)
            cmd = ['/bin/bash', '-c', cmd_str]
        
        elif disguise == 'shell':
            # Direct shell execution (most common, least suspicious)
            cmd_str = ' '.join(target)
            cmd = ['/bin/sh', '-c', f'exec {cmd_str}']
        
        else:
            cmd = target
        
        # Try to spoof process name before exec
        self._spoof_argv0(disguise)
        
        try:
            result = subprocess.run(cmd, check=False)
            return result.returncode
        except Exception as e:
            print(f"[hide] Error: {e}")
            return 1
    
    def spawn_decoy(self, count: int = 3):
        """Spawn decoy processes to confuse ps/top."""
        spawned = []
        
        for _ in range(count):
            try:
                # Pick random decoy
                decoy = random.choice(DECOY_COMMANDS)
                
                # Spawn via shell (looks like shell subprocess)
                proc = subprocess.Popen(
                    ['/bin/sh', '-c', decoy],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True
                )
                
                spawned.append(proc.pid)
            except:
                pass
        
        if spawned:
            print(f"[hide] Spawned {len(spawned)} decoy processes")
        
        return spawned
    
    def flatten_process_tree(self, command: List[str]) -> subprocess.Popen:
        """Run process without obvious parent (via double fork)."""
        try:
            # First fork
            pid = os.fork()
            if pid > 0:
                # Parent returns immediately
                return None
            
            # Child process
            os.setsid()  # New session
            
            # Second fork
            pid = os.fork()
            if pid > 0:
                os._exit(0)
            
            # Grandchild - no parent now
            # Redirect stdio
            os.close(0)
            os.close(1)
            os.close(2)
            
            # Execute target
            os.execvp(command[0], command)
            os._exit(1)
            
        except Exception as e:
            print(f"[hide] Fork error: {e}")
            # Fallback: normal spawn
            return subprocess.Popen(
                command,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True
            )
    
    def get_process_status(self):
        """Show current process status."""
        print(f"Process Masquerade v{self.VERSION}")
        print(f"Real PID: {os.getpid()}")
        print(f"PPID: {os.getppid()}")
        print(f"Session: {os.getsid(0)}")
        
        # Try to get current name
        try:
            with open(f'/proc/{os.getpid()}/comm') as f:
                comm = f.read().strip()
            print(f"Kernel name: {comm}")
        except:
            pass
        
        # Show cmdline
        try:
            with open(f'/proc/{os.getpid()}/cmdline') as f:
                cmdline = f.read().replace('\x00', ' ')
            print(f"Cmdline: {cmdline[:60]}...")
        except:
            pass
        
        # Check if we're being traced
        try:
            status = open(f'/proc/{os.getpid()}/status').read()
            if 'TracerPid:\t0' not in status:
                print("WARNING: Process being traced!")
        except:
            pass
    
    def run_daemon(self):
        """Run masquerade daemon."""
        import signal
        
        def handler(signum, frame):
            sys.exit(0)
        
        signal.signal(signal.SIGTERM, handler)
        
        # Spawn decoys periodically
        while True:
            self.spawn_decoy(random.randint(1, 3))
            time.sleep(random.randint(300, 900))  # 5-15 minutes


def main():
    """CLI entry."""
    parser = argparse.ArgumentParser(
        prog='hivedev-hide',
        description='Process Masquerade'
    )
    parser.add_argument('command', 
                       choices=['run', 'decoy', 'status', 'daemon'])
    parser.add_argument('target', nargs='?', help='Command to run')
    parser.add_argument('--as', dest='disguise', default='python',
                       choices=['python', 'bash', 'shell'],
                       help='Masquerade identity')
    parser.add_argument('--count', '-c', type=int, default=3,
                       help='Number of decoys')
    
    args = parser.parse_args()
    
    masq = ProcessMasquerade()
    
    if args.command == 'run':
        if not args.target:
            print("[hide] ERROR: target required")
            return 1
        
        target = args.target.split()
        return masq.masquerade_and_run(target, args.disguise)
    
    elif args.command == 'decoy':
        masq.spawn_decoy(args.count)
    
    elif args.command == 'status':
        masq.get_process_status()
    
    elif args.command == 'daemon':
        print("[hide] Starting masquerade daemon")
        masq.run_daemon()
    
    return 0


if __name__ == '__main__':
    sys.exit(main())
