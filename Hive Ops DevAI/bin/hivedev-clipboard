#!/usr/bin/env python3
"""
HIVE OPS DevAI - Secure Clipboard Module v1.0
Auto-clear sensitive data to prevent clipboard leaks

Purpose:
  Automatically clear clipboard contents after a configurable
timeout. Prevents sensitive data (passwords, keys, secrets) from
remaining in clipboard history where other apps can access it.

Features:
  - Auto-clear after timeout (default: 30 seconds)
  - Pattern detection (auto-detect sensitive data)
  - Manual clear with hotkey
  - Clipboard history sanitization
  - Integration with vault (secure paste)
  - Termux/Android support via termux-clipboard

Usage:
  hivedev-clipboard start              # Start secure clipboard daemon
  hivedev-clipboard stop               # Stop daemon
  hivedev-clipboard status             # Show status
  hivedev-clipboard clear              # Clear clipboard now
  hivedev-clipboard set "secret"       # Set with auto-clear
  hivedev-clipboard config --timeout 60 # Set timeout
  hivedev-clipboard history            # Show clipboard history
  hivedev-clipboard wipe-history       # Clear clipboard history

Security:
  - Clears clipboard, not just memory reference
  - Overwrites clipboard with innocuous data
  - No persistent logging of clipboard contents
  - Termux API integration for Android
"""

import os
import sys
import re
import json
import time
import threading
import argparse
import subprocess
from pathlib import Path
from typing import Optional, List, Dict
from dataclasses import dataclass
from datetime import datetime

@dataclass
class ClipboardEntry:
    """Clipboard entry metadata (not content)."""
    timestamp: float
    content_hash: str
    content_type: str  # 'sensitive', 'normal', 'unknown'
    auto_cleared: bool

class SecureClipboard:
    """
    Secure clipboard manager with auto-clear.
    
    Monitors clipboard and automatically clears sensitive
    content after configurable timeout.
    """
    
    VERSION = "1.0"
    
    # Sensitive data patterns
    SENSITIVE_PATTERNS = {
        'password': r'(?i)(password|passwd|pwd)\s*[=:]\s*\S+',
        'api_key': r'(?i)(api[_-]?key|apikey)\s*[=:]\s*[a-zA-Z0-9]{16,}',
        'token': r'(?i)(token|bearer)\s*[=:]\s*[a-zA-Z0-9-_]{20,}',
        'private_key': r'-----BEGIN (RSA |DSA |EC |OPENSSH )?PRIVATE KEY-----',
        'seed_phrase': r'\b([a-z]+\s+){11,23}[a-z]+\b',  # BIP39-like
        'mnemonic': r'\b([a-z]+\s+){11,23}[a-z]+\b',
        'bitcoin_addr': r'\b[13][a-km-zA-HJ-NP-Z1-9]{25,34}\b',
        'eth_addr': r'\b0x[a-fA-F0-9]{40}\b',
        'credit_card': r'\b\d{4}[-\s]?\d{4}[-\s]?\d{4}[-\s]?\d{4}\b',
        'ssn': r'\b\d{3}-\d{2}-\d{4}\b',
        'secret': r'(?i)(secret|private|hidden)\s*[=:]\s*\S+',
    }
    
    # Innocuous replacement content
    INNOCUOUS_CONTENTS = [
        'https://www.google.com',
        'example@email.com',
        'Meeting at 3pm',
        'Call mom later',
        'Grocery list: milk, eggs',
    ]
    
    def __init__(self):
        self.data_dir = Path.home() / '.local' / 'share' / 'hivedev'
        self.config_file = self.data_dir / 'clipboard_config.json'
        self.history_file = self.data_dir / 'clipboard_history.json'
        self.pid_file = self.data_dir / 'clipboard.pid'
        
        self.timeout = 30  # seconds
        self.enabled = False
        self.running = False
        self.monitor_thread = None
        self.last_content = ""
        self.clear_timer = None
        self.history: List[ClipboardEntry] = []
        
        self._load_config()
        self._load_history()
    
    def _load_config(self):
        """Load configuration."""
        if self.config_file.exists():
            try:
                config = json.loads(self.config_file.read_text())
                self.timeout = config.get('timeout', 30)
                self.enabled = config.get('enabled', False)
            except:
                pass
    
    def _save_config(self):
        """Save configuration."""
        self.data_dir.mkdir(parents=True, exist_ok=True)
        config = {
            'timeout': self.timeout,
            'enabled': self.enabled,
            'version': self.VERSION
        }
        self.config_file.write_text(json.dumps(config, indent=2))
    
    def _load_history(self):
        """Load clipboard history (metadata only)."""
        if self.history_file.exists():
            try:
                data = json.loads(self.history_file.read_text())
                self.history = [
                    ClipboardEntry(
                        timestamp=e['timestamp'],
                        content_hash=e['content_hash'],
                        content_type=e['content_type'],
                        auto_cleared=e['auto_cleared']
                    )
                    for e in data.get('entries', [])
                ]
            except:
                pass
    
    def _save_history(self):
        """Save clipboard history (metadata only)."""
        data = {
            'entries': [
                {
                    'timestamp': e.timestamp,
                    'content_hash': e.content_hash,
                    'content_type': e.content_type,
                    'auto_cleared': e.auto_cleared
                }
                for e in self.history[-100:]  # Keep last 100
            ]
        }
        self.history_file.write_text(json.dumps(data, indent=2))
    
    def _get_clipboard(self) -> Optional[str]:
        """Get clipboard content."""
        try:
            # Try termux-api first (Android)
            result = subprocess.run(
                ['termux-clipboard-get'],
                capture_output=True,
                text=True,
                timeout=2
            )
            if result.returncode == 0:
                return result.stdout
        except:
            pass
        
        try:
            # Try xclip (Linux/X11)
            result = subprocess.run(
                ['xclip', '-selection', 'clipboard', '-o'],
                capture_output=True,
                text=True,
                timeout=2
            )
            if result.returncode == 0:
                return result.stdout
        except:
            pass
        
        try:
            # Try wl-copy (Wayland)
            result = subprocess.run(
                ['wl-paste'],
                capture_output=True,
                text=True,
                timeout=2
            )
            if result.returncode == 0:
                return result.stdout
        except:
            pass
        
        return None
    
    def _set_clipboard(self, content: str) -> bool:
        """Set clipboard content."""
        try:
            # Try termux-api first
            result = subprocess.run(
                ['termux-clipboard-set', content],
                capture_output=True,
                timeout=2
            )
            if result.returncode == 0:
                return True
        except:
            pass
        
        try:
            # Try xclip
            proc = subprocess.Popen(
                ['xclip', '-selection', 'clipboard', '-i'],
                stdin=subprocess.PIPE,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )
            proc.communicate(content.encode(), timeout=2)
            return proc.returncode == 0
        except:
            pass
        
        try:
            # Try wl-copy
            proc = subprocess.Popen(
                ['wl-copy'],
                stdin=subprocess.PIPE,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )
            proc.communicate(content.encode(), timeout=2)
            return proc.returncode == 0
        except:
            pass
        
        return False
    
    def _analyze_content(self, content: str) -> str:
        """Analyze content type."""
        if not content:
            return 'empty'
        
        content_lower = content.lower()
        
        for pattern_name, pattern in self.SENSITIVE_PATTERNS.items():
            if re.search(pattern, content):
                return 'sensitive'
        
        # Check entropy (high entropy = likely sensitive)
        if self._calculate_entropy(content) > 4.5:
            return 'suspicious'
        
        return 'normal'
    
    def _calculate_entropy(self, text: str) -> float:
        """Calculate Shannon entropy."""
        import math
        
        if not text:
            return 0.0
        
        freq = {}
        for char in text:
            freq[char] = freq.get(char, 0) + 1
        
        length = len(text)
        entropy = -sum((count/length) * math.log2(count/length) 
                      for count in freq.values())
        
        return entropy
    
    def _schedule_clear(self, timeout: int = None):
        """Schedule clipboard clear."""
        if self.clear_timer:
            self.clear_timer.cancel()
        
        clear_after = timeout or self.timeout
        
        self.clear_timer = threading.Timer(clear_after, self._auto_clear)
        self.clear_timer.daemon = True
        self.clear_timer.start()
        
        print(f"[clipboard] Will clear in {clear_after}s")
    
    def _auto_clear(self):
        """Auto-clear clipboard."""
        print("[clipboard] Auto-clearing...")
        
        # Overwrite with innocuous content first
        innocuous = self.INNOCUOUS_CONTENTS[
            hash(str(time.time())) % len(self.INNOCUOUS_CONTENTS)
        ]
        self._set_clipboard(innocuous)
        
        # Then clear
        self._set_clipboard("")
        
        # Log
        self._log_clear(auto=True)
        
        print("[clipboard] Cleared")
    
    def _log_entry(self, content: str, content_type: str):
        """Log clipboard entry (hash only, not content)."""
        import hashlib
        
        entry = ClipboardEntry(
            timestamp=time.time(),
            content_hash=hashlib.sha256(content.encode()).hexdigest()[:16],
            content_type=content_type,
            auto_cleared=False
        )
        
        self.history.append(entry)
        self._save_history()
    
    def _log_clear(self, auto: bool = False):
        """Log clipboard clear."""
        if self.history:
            self.history[-1].auto_cleared = auto
            self._save_history()
    
    def _monitor_loop(self):
        """Background monitoring loop."""
        print("[clipboard] Monitor started")
        
        while self.running:
            try:
                current = self._get_clipboard()
                
                if current and current != self.last_content:
                    content_type = self._analyze_content(current)
                    
                    print(f"[clipboard] New content detected ({content_type})")
                    
                    # Log entry (metadata only)
                    self._log_entry(current, content_type)
                    
                    # Auto-clear if sensitive
                    if content_type == 'sensitive':
                        print("[clipboard] SENSITIVE - scheduling clear")
                        self._schedule_clear()
                    elif content_type == 'suspicious':
                        print("[clipboard] SUSPICIOUS - scheduling clear")
                        self._schedule_clear(self.timeout // 2)
                    
                    self.last_content = current
                
                time.sleep(1)  # Check every second
                
            except Exception as e:
                print(f"[clipboard] Monitor error: {e}")
                time.sleep(5)
        
        print("[clipboard] Monitor stopped")
    
    def start(self) -> bool:
        """Start secure clipboard daemon."""
        if self.is_running():
            print("[clipboard] Already running")
            return True
        
        self.running = True
        self.enabled = True
        self._save_config()
        
        # Write PID file
        self.data_dir.mkdir(parents=True, exist_ok=True)
        self.pid_file.write_text(str(os.getpid()))
        
        # Start monitor thread
        self.monitor_thread = threading.Thread(target=self._monitor_loop)
        self.monitor_thread.daemon = True
        self.monitor_thread.start()
        
        print(f"[clipboard] Secure clipboard started")
        print(f"[clipboard] Timeout: {self.timeout}s")
        print(f"[clipboard] Monitoring for sensitive data...")
        
        return True
    
    def stop(self):
        """Stop secure clipboard daemon."""
        self.running = False
        self.enabled = False
        self._save_config()
        
        if self.clear_timer:
            self.clear_timer.cancel()
        
        if self.pid_file.exists():
            self.pid_file.unlink()
        
        print("[clipboard] Stopped")
    
    def is_running(self) -> bool:
        """Check if daemon is running."""
        if not self.pid_file.exists():
            return False
        
        try:
            pid = int(self.pid_file.read_text())
            os.kill(pid, 0)
            return True
        except:
            return False
    
    def clear_now(self) -> bool:
        """Clear clipboard immediately."""
        # Overwrite first
        innocuous = self.INNOCUOUS_CONTENTS[0]
        self._set_clipboard(innocuous)
        
        # Then clear
        result = self._set_clipboard("")
        
        self._log_clear(auto=False)
        
        print("[clipboard] Cleared")
        return result
    
    def set_clipboard(self, content: str, sensitive: bool = True) -> bool:
        """Set clipboard with auto-clear."""
        if not self._set_clipboard(content):
            print("[clipboard] Failed to set clipboard")
            return False
        
        content_type = 'sensitive' if sensitive else self._analyze_content(content)
        self._log_entry(content, content_type)
        
        if sensitive or content_type == 'sensitive':
            self._schedule_clear()
            print(f"[clipboard] Set (will clear in {self.timeout}s)")
        else:
            print("[clipboard] Set (not sensitive)")
        
        return True
    
    def get_history(self) -> List[Dict]:
        """Get clipboard history (metadata only)."""
        return [
            {
                'time': datetime.fromtimestamp(e.timestamp).strftime('%H:%M:%S'),
                'type': e.content_type,
                'hash': e.content_hash,
                'cleared': e.auto_cleared
            }
            for e in self.history[-20:]  # Last 20
        ]
    
    def wipe_history(self):
        """Clear clipboard history."""
        self.history = []
        if self.history_file.exists():
            self.history_file.unlink()
        print("[clipboard] History wiped")
    
    def config(self, timeout: int = None, enabled: bool = None):
        """Configure settings."""
        if timeout is not None:
            self.timeout = timeout
            print(f"[clipboard] Timeout set to {timeout}s")
        
        if enabled is not None:
            self.enabled = enabled
            print(f"[clipboard] Enabled: {enabled}")
        
        self._save_config()
    
    def status(self):
        """Show status."""
        print(f"Secure Clipboard v{self.VERSION}")
        print(f"\nConfiguration:")
        print(f"  Running: {'Yes' if self.is_running() else 'No'}")
        print(f"  Timeout: {self.timeout}s")
        print(f"  Enabled: {'Yes' if self.enabled else 'No'}")
        
        print(f"\nHistory:")
        print(f"  Entries: {len(self.history)}")
        sensitive = len([e for e in self.history if e.content_type == 'sensitive'])
        print(f"  Sensitive: {sensitive}")
        auto_cleared = len([e for e in self.history if e.auto_cleared])
        print(f"  Auto-cleared: {auto_cleared}")


def main():
    """CLI entry."""
    parser = argparse.ArgumentParser(prog='hivedev-clipboard')
    parser.add_argument('command',
                       choices=['start', 'stop', 'status', 'clear', 
                               'set', 'config', 'history', 'wipe-history'])
    parser.add_argument('--content', '-c', help='Content to set')
    parser.add_argument('--timeout', '-t', type=int, help='Clear timeout (seconds)')
    parser.add_argument('--sensitive', '-s', action='store_true',
                       help='Mark as sensitive')
    
    args = parser.parse_args()
    
    sc = SecureClipboard()
    
    if args.command == 'start':
        return 0 if sc.start() else 1
    
    elif args.command == 'stop':
        sc.stop()
    
    elif args.command == 'status':
        sc.status()
    
    elif args.command == 'clear':
        return 0 if sc.clear_now() else 1
    
    elif args.command == 'set':
        if not args.content:
            print("[clipboard] ERROR: --content required")
            return 1
        return 0 if sc.set_clipboard(args.content, args.sensitive) else 1
    
    elif args.command == 'config':
        sc.config(timeout=args.timeout)
    
    elif args.command == 'history':
        history = sc.get_history()
        print(f"{'Time':<10} {'Type':<12} {'Hash':<20} {'Cleared'}")
        print("-" * 50)
        for entry in history:
            cleared = "✓" if entry['cleared'] else ""
            print(f"{entry['time']:<10} {entry['type']:<12} {entry['hash']:<20} {cleared}")
    
    elif args.command == 'wipe-history':
        sc.wipe_history()
    
    return 0


if __name__ == '__main__':
    sys.exit(main())
