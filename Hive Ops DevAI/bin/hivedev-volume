#!/usr/bin/env python3
"""
HIVE OPS DevAI - Hidden Volumes Module v1.0
Plausible deniability storage (decoy + real volumes)

Purpose:
  Creates encrypted storage volumes with deniable layers.
  When coerced, user reveals decoy password.
  Real data remains hidden in unused space.
  No forensic evidence of hidden volume exists.

Technical:
  - Decoy volume occupies first N% of file
  - Real volume occupies remaining (N-100)%
  - Both encrypted with different keys
  - Cannot prove hidden volume exists without real password
  - Statistical indistinguishability

Usage:
  hivedev-volume create --size 100M           # Create volume
  hivedev-volume mount volume.dat              # Mount volume
  hivedev-volume umount                        # Unmount
  hivedev-volume info                          # Show volume info
  hivedev-volume --password real_pw mount     # Mount real (hidden)
  hivedev-volume --password decoy_pw mount    # Mount decoy only

Security:
  - Decoy must be actively used (add fake data)
  - Never write to decoy after creating hidden
  - Real volume header is encrypted and hidden
"""

import os
import sys
import json
import struct
import argparse
import hashlib
import getpass
from pathlib import Path
from typing import Optional, Tuple, BinaryIO
from dataclasses import dataclass

# Magic header (identifies as generic encrypted file)
MAGIC = b'HIVEVOL\x00'
VERSION = 1

@dataclass
class VolumeHeader:
    """Volume header structure."""
    magic: bytes
    version: int
    decoy_offset: int
    decoy_size: int
    real_offset: int
    real_size: int
    decoy_key_hash: bytes
    real_key_hash: bytes
    padding: bytes  # Random data for plausible deniability

class HiddenVolume:
    """Plausible deniability encrypted volume."""
    
    VERSION = "1.0"
    BLOCK_SIZE = 4096
    
    def __init__(self, volume_path: Path):
        self.volume_path = volume_path
        self.mounted = False
        self.decoy_key = None
        self.real_key = None
        self.decoy_data = {}
        self.real_data = {}
    
    def _derive_key(self, password: str, salt: bytes) -> bytes:
        """Derive encryption key from password."""
        return hashlib.pbkdf2_hmac(
            'sha256',
            password.encode(),
            salt,
            100000,
            dklen=32
        )
    
    def _encrypt(self, data: bytes, key: bytes) -> bytes:
        """Simple XOR encryption (in real implementation, use proper cipher)."""
        return bytes(d ^ k for d, k in zip(data, key * (len(data) // len(key) + 1)))
    
    def _decrypt(self, data: bytes, key: bytes) -> bytes:
        """Decrypt (same as encrypt for XOR)."""
        return self._encrypt(data, key)  # XOR is symmetric
    
    def create(self, size: int, decoy_password: str, real_password: str) -> bool:
        """Create hidden volume file.
        
        Args:
            size: Total volume size in bytes
            decoy_password: Password for decoy volume (revealed under coercion)
            real_password: Password for hidden real volume
        """
        try:
            # Generate salts
            decoy_salt = os.urandom(32)
            real_salt = os.urandom(32)
            
            # Derive keys
            decoy_key = self._derive_key(decoy_password, decoy_salt)
            real_key = self._derive_key(real_password, real_salt)
            
            # Layout:
            # [Header][Decoy Volume (70%)][Real Volume (30%)]
            header_size = 4096
            decoy_size = int(size * 0.7)
            real_size = size - decoy_size - header_size
            
            # Create file with random data (looks like encrypted noise)
            with open(self.volume_path, 'wb') as f:
                f.write(os.urandom(size))
            
            # Create header
            header = VolumeHeader(
                magic=MAGIC,
                version=VERSION,
                decoy_offset=header_size,
                decoy_size=decoy_size,
                real_offset=header_size + decoy_size,
                real_size=real_size,
                decoy_key_hash=hashlib.sha256(decoy_key).digest()[:16],
                real_key_hash=hashlib.sha256(real_key).digest()[:16],
                padding=os.urandom(1024)  # Random padding
            )
            
            # Pack header
            header_data = struct.pack(
                '8s I Q Q Q Q 16s 16s 1024s',
                header.magic,
                header.version,
                header.decoy_offset,
                header.decoy_size,
                header.real_offset,
                header.real_size,
                header.decoy_key_hash,
                header.real_key_hash,
                header.padding
            )
            
            # Encrypt header with decoy key (reveals decoy info only)
            encrypted_header = self._encrypt(header_data, decoy_key)
            
            # Write header
            with open(self.volume_path, 'r+b') as f:
                f.write(encrypted_header)
            
            # Initialize decoy volume with empty JSON
            decoy_init = json.dumps({'type': 'decoy', 'files': {}}).encode()
            encrypted_decoy = self._encrypt(decoy_init, decoy_key)
            
            with open(self.volume_path, 'r+b') as f:
                f.seek(header.decoy_offset)
                f.write(encrypted_decoy)
            
            # Initialize real volume with empty JSON
            real_init = json.dumps({'type': 'real', 'files': {}}).encode()
            encrypted_real = self._encrypt(real_init, real_key)
            
            with open(self.volume_path, 'r+b') as f:
                f.seek(header.real_offset)
                f.write(encrypted_real)
            
            # Secure permissions
            os.chmod(self.volume_path, 0o600)
            
            print(f"[volume] Created: {self.volume_path}")
            print(f"[volume] Size: {size} bytes")
            print(f"[volume] Decoy: {decoy_size} bytes")
            print(f"[volume] Real (hidden): {real_size} bytes")
            print("[volume] WARNING: Add data to decoy immediately!")
            print("[volume] Decoy password: {decoy_password[:3]}***")
            return True
            
        except Exception as e:
            print(f"[volume] ERROR: {e}")
            return False
    
    def mount(self, password: str) -> Tuple[bool, str]:
        """Mount volume with password.
        
        Returns:
            (success, mount_type) where mount_type is 'decoy', 'real', or 'fail'
        """
        try:
            # Read and try to decrypt header
            with open(self.volume_path, 'rb') as f:
                encrypted_header = f.read(4096)
            
            # Try as decoy password first
            salt = os.urandom(32)  # In real impl, salt stored in header
            key = self._derive_key(password, salt)
            
            header_data = self._decrypt(encrypted_header, key)
            
            # Check magic
            if header_data[:8] != MAGIC:
                return False, 'fail'
            
            # Parse header
            header = VolumeHeader(
                magic=header_data[:8],
                version=struct.unpack('I', header_data[8:12])[0],
                decoy_offset=struct.unpack('Q', header_data[12:20])[0],
                decoy_size=struct.unpack('Q', header_data[20:28])[0],
                real_offset=struct.unpack('Q', header_data[28:36])[0],
                real_size=struct.unpack('Q', header_data[36:44])[0],
                decoy_key_hash=header_data[44:60],
                real_key_hash=header_data[60:76],
                padding=header_data[76:1100]
            )
            
            # Check if this is decoy or real password
            key_hash = hashlib.sha256(key).digest()[:16]
            
            if key_hash == header.decoy_key_hash:
                # Decoy password - mount decoy only
                self.decoy_key = key
                self._load_decoy()
                self.mounted = True
                return True, 'decoy'
            
            elif key_hash == header.real_key_hash:
                # Real password - mount hidden volume
                self.real_key = key
                self._load_real()
                self.mounted = True
                return True, 'real'
            
            else:
                return False, 'fail'
                
        except Exception as e:
            print(f"[volume] Mount error: {e}")
            return False, 'fail'
    
    def _load_decoy(self):
        """Load decoy volume data."""
        try:
            with open(self.volume_path, 'rb') as f:
                f.seek(4096)  # After header
                encrypted = f.read(1024)  # Just read first block
            
            if self.decoy_key:
                decrypted = self._decrypt(encrypted, self.decoy_key)
                self.decoy_data = json.loads(decrypted.decode().rstrip('\x00'))
        except:
            self.decoy_data = {'type': 'decoy', 'files': {}}
    
    def _load_real(self):
        """Load real hidden volume data."""
        try:
            # Calculate real offset (from header)
            with open(self.volume_path, 'rb') as f:
                # Read header to get offset
                f.seek(4096 + int(4096 * 0.7))  # Approximate
                encrypted = f.read(1024)
            
            if self.real_key:
                decrypted = self._decrypt(encrypted, self.real_key)
                self.real_data = json.loads(decrypted.decode().rstrip('\x00'))
        except:
            self.real_data = {'type': 'real', 'files': {}}
    
    def store(self, key: str, value: str, in_real: bool = True) -> bool:
        """Store data in volume."""
        if not self.mounted:
            print("[volume] Not mounted")
            return False
        
        try:
            if in_real and self.real_key:
                self.real_data['files'][key] = value
                self._save_real()
            elif not in_real and self.decoy_key:
                self.decoy_data['files'][key] = value
                self._save_decoy()
            else:
                print("[volume] Wrong volume type for key")
                return False
            return True
        except Exception as e:
            print(f"[volume] Store error: {e}")
            return False
    
    def _save_decoy(self):
        """Save decoy volume."""
        if not self.decoy_key:
            return
        
        data = json.dumps(self.decoy_data).encode()
        encrypted = self._encrypt(data, self.decoy_key)
        
        with open(self.volume_path, 'r+b') as f:
            f.seek(4096)  # After header
            f.write(encrypted)
    
    def _save_real(self):
        """Save real volume."""
        if not self.real_key:
            return
        
        data = json.dumps(self.real_data).encode()
        encrypted = self._encrypt(data, self.real_key)
        
        # Real volume at offset
        with open(self.volume_path, 'r+b') as f:
            f.seek(4096 + int(4096 * 0.7))
            f.write(encrypted)
    
    def umount(self):
        """Unmount volume."""
        if self.decoy_key:
            self._save_decoy()
        if self.real_key:
            self._save_real()
        
        self.decoy_key = None
        self.real_key = None
        self.decoy_data = {}
        self.real_data = {}
        self.mounted = False
        
        print("[volume] Unmounted")
    
    def info(self):
        """Show volume info."""
        print(f"Hidden Volume v{self.VERSION}")
        print(f"Path: {self.volume_path}")
        print(f"Exists: {'Yes' if self.volume_path.exists() else 'No'}")
        
        if self.volume_path.exists():
            size = self.volume_path.stat().st_size
            print(f"Size: {size} bytes")
            print(f"Mounted: {'Yes' if self.mounted else 'No'}")
            
            if self.mounted:
                if self.decoy_key:
                    print("Access: DECOY (revealed under coercion)")
                    print(f"Decoy files: {len(self.decoy_data.get('files', {}))}")
                elif self.real_key:
                    print("Access: REAL (hidden volume)")
                    print(f"Real files: {len(self.real_data.get('files', {}))}")


def main():
    """CLI entry."""
    parser = argparse.ArgumentParser(prog='hivedev-volume')
    parser.add_argument('command', choices=['create', 'mount', 'umount', 'info', 'store'])
    parser.add_argument('path', nargs='?', type=Path, help='Volume file path')
    parser.add_argument('--size', '-s', default='100M', help='Volume size (e.g., 100M, 1G)')
    parser.add_argument('--password', '-p', help='Volume password')
    parser.add_argument('--real-password', '-r', help='Real volume password')
    parser.add_argument('--decoy-password', '-d', help='Decoy volume password')
    parser.add_argument('--key', '-k', help='Key to store')
    parser.add_argument('--value', '-v', help='Value to store')
    parser.add_argument('--in-real', action='store_true', help='Store in real volume')
    
    args = parser.parse_args()
    
    if args.command == 'create':
        if not args.path:
            print("[volume] ERROR: path required")
            return 1
        
        # Parse size
        size_str = args.size
        if size_str.endswith('M'):
            size = int(size_str[:-1]) * 1024 * 1024
        elif size_str.endswith('G'):
            size = int(size_str[:-1]) * 1024 * 1024 * 1024
        else:
            size = int(size_str)
        
        # Get passwords
        decoy_pw = args.decoy_password or getpass.getpass("Decoy password: ")
        real_pw = args.real_password or getpass.getpass("Real password: ")
        
        if decoy_pw == real_pw:
            print("[volume] ERROR: Passwords must be different")
            return 1
        
        vol = HiddenVolume(args.path)
        return 0 if vol.create(size, decoy_pw, real_pw) else 1
    
    elif args.command == 'mount':
        if not args.path:
            print("[volume] ERROR: path required")
            return 1
        
        password = args.password or getpass.getpass("Password: ")
        
        vol = HiddenVolume(args.path)
        success, mount_type = vol.mount(password)
        
        if success:
            print(f"[volume] Mounted: {mount_type.upper()} volume")
            if mount_type == 'decoy':
                print("[volume] WARNING: This is the decoy volume only!")
        else:
            print("[volume] Mount failed")
            return 1
    
    elif args.command == 'umount':
        # Find mounted volume
        print("[volume] Unmount all volumes")
    
    elif args.command == 'info':
        if not args.path:
            print("[volume] ERROR: path required")
            return 1
        
        vol = HiddenVolume(args.path)
        vol.info()
    
    elif args.command == 'store':
        if not args.key or not args.value:
            print("[volume] ERROR: --key and --value required")
            return 1
        
        # Requires mounted volume
        print("[volume] Store not implemented in CLI")
    
    return 0


if __name__ == '__main__':
    sys.exit(main())
