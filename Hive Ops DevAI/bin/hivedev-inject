#!/usr/bin/env python3
"""
HIVE OPS DevAI - Process Injector Detector v3.0
Code/DLL injection and API hooking detection

Purpose:
  Detect process injection attacks including code injection,
  DLL injection, process hollowing, APC injection, and API
  hooking. Monitors process integrity in real-time.

Attack Vectors Detected:
  - Classic DLL injection (CreateRemoteThread + LoadLibrary)
  - Process hollowing (CreateProcess suspended + unmap + write)
  - APC injection (QueueUserAPC + alertable thread)
  - Thread hijacking (SetThreadContext)
  - Code cave injection (RWX memory allocation)
  - Reflective DLL injection (manual mapping)
  - Process doppelgänging (NTFS transaction abuse)
  - Atom bombing (GlobalAddAtom + NtQueueApcThread)
  - PROPagate (UxTheme SetProp abuse)
  - API hooking (IAT/EAT manipulation)

Detection Methods:
  - Memory scanning (unexpected code regions)
  - Import table verification
  - Thread context analysis
  - Handle enumeration
  - Callback table inspection
  - Entropy analysis for encrypted payloads

Usage:
  hive-inject scan --pid PID              # Scan specific process
  hive-inject monitor --all               # Monitor all processes
  hive-inject check --dll path            # Verify DLL integrity
  hive-inject hooks --process name        # Detect API hooks
  hive-inject report                      # Generate detection report
  hive-inject protect --critical          # Enable self-protection
  hive-inject whitelist --add path      # Add to whitelist

Author: Hive Ops DevAI
Version: 3.0.0
"""

import os
import sys
import ctypes
import struct
import hashlib
import argparse
import threading
import subprocess
from pathlib import Path
from typing import Optional, List, Dict, Tuple, Set
from dataclasses import dataclass
from datetime import datetime
from enum import Enum

class InjectionType(Enum):
    NONE = "none"
    DLL_INJECTION = "dll_injection"
    CODE_INJECTION = "code_injection"
    PROCESS_HOLLOWING = "process_hollowing"
    APC_INJECTION = "apc_injection"
    REFLECTIVE_DLL = "reflective_dll"
    THREAD_HIJACKING = "thread_hijacking"
    IAT_HOOKING = "iat_hooking"
    INLINE_HOOKING = "inline_hooking"
    UNKNOWN = "unknown"

@dataclass
class MemoryRegion:
    """Memory region analysis."""
    base_address: int
    size: int
    protection: str
    mapped_file: Optional[str]
    entropy: float
    is_executable: bool
    is_writable: bool
    suspicious_patterns: List[str]

@dataclass
class InjectionFinding:
    """Detected injection artifact."""
    finding_id: str
    process_id: int
    process_name: str
    injection_type: InjectionType
    severity: str  # LOW, MEDIUM, HIGH, CRITICAL
    details: Dict
    timestamp: float
    memory_region: Optional[MemoryRegion]

class MemoryAnalyzer:
    """
    Memory region analyzer for injection detection.
    
    Detects:
    - Unexpected executable memory
    - RWX pages (Read-Write-Execute)
    - Injected shellcode
    - Hollowed processes
    """
    
    # Known suspicious memory patterns
    SHELLCODE_PATTERNS = [
        b'\x4d\x5a',           # MZ header (injected PE)
        b'\x90\x90\x90\x90',   # NOP sleds
        b'\xcc\xcc\xcc\xcc',   # INT3 padding
        b'\xe8\x00\x00\x00\x00',  # Call to POP (position independent)
        b'\xfc\x48\x83\xe4',   # Common x64 shellcode prologue
    ]
    
    def __init__(self):
        self.known_modules: Set[str] = set()
        self.suspicious_regions: List[MemoryRegion] = []
    
    def scan_region(self, pid: int, base: int, size: int) -> Optional[MemoryRegion]:
        """Scan memory region for injection artifacts."""
        try:
            # Read process memory (would use /proc/PID/mem on Linux)
            mem_path = f"/proc/{pid}/mem"
            if not os.path.exists(mem_path):
                return None
            
            with open(mem_path, 'rb') as f:
                f.seek(base)
                data = f.read(min(size, 4096))  # Sample first page
            
            if not data:
                return None
            
            # Calculate entropy
            entropy = self._calculate_entropy(data)
            
            # Check for patterns
            patterns = self._find_patterns(data)
            
            # Check memory maps
            maps_path = f"/proc/{pid}/maps"
            mapped_file = None
            protection = ""
            
            if os.path.exists(maps_path):
                with open(maps_path) as f:
                    for line in f:
                        parts = line.split()
                        if len(parts) >= 6:
                            addr_range = parts[0].split('-')
                            if len(addr_range) == 2:
                                start = int(addr_range[0], 16)
                                if start == base:
                                    protection = parts[1]
                                    mapped_file = parts[5] if len(parts) > 5 else None
                                    break
            
            is_exec = 'x' in protection
            is_write = 'w' in protection
            
            region = MemoryRegion(
                base_address=base,
                size=size,
                protection=protection,
                mapped_file=mapped_file,
                entropy=entropy,
                is_executable=is_exec,
                is_writable=is_write,
                suspicious_patterns=patterns
            )
            
            return region
            
        except PermissionError:
            return None
        except Exception as e:
            return None
    
    def _calculate_entropy(self, data: bytes) -> float:
        """Calculate Shannon entropy of data."""
        if not data:
            return 0.0
        
        entropy = 0.0
        length = len(data)
        
        for x in range(256):
            p_x = data.count(x) / length
            if p_x > 0:
                entropy += -p_x * (p_x.bit_length() - 1)
        
        return entropy / 8.0  # Normalize to 0-1
    
    def _find_patterns(self, data: bytes) -> List[str]:
        """Find suspicious patterns in data."""
        patterns = []
        
        for pattern in self.SHELLCODE_PATTERNS:
            if pattern in data:
                patterns.append(f"Pattern: {pattern.hex()}")
        
        # Check for executable headers
        if data[:2] == b'MZ':
            patterns.append("PE header (possible reflective DLL)")
        
        if data[:4] == b'\x7fELF':
            patterns.append("ELF header (possible injection)")
        
        return patterns
    
    def analyze_process_memory(self, pid: int) -> List[InjectionFinding]:
        """Analyze all memory regions of process."""
        findings = []
        
        try:
            maps_path = f"/proc/{pid}/maps"
            if not os.path.exists(maps_path):
                return findings
            
            with open(maps_path) as f:
                for line in f:
                    parts = line.split()
                    if len(parts) < 5:
                        continue
                    
                    # Parse address range
                    addr_range = parts[0].split('-')
                    if len(addr_range) != 2:
                        continue
                    
                    base = int(addr_range[0], 16)
                    end = int(addr_range[1], 16)
                    size = end - base
                    
                    protection = parts[1]
                    
                    # Scan suspicious regions
                    if 'x' in protection and size < 1024 * 1024 * 100:  # Skip huge regions
                        region = self.scan_region(pid, base, size)
                        if region:
                            finding = self._classify_region(pid, region)
                            if finding:
                                findings.append(finding)
        
        except Exception as e:
            pass
        
        return findings
    
    def _classify_region(self, pid: int, region: MemoryRegion) -> Optional[InjectionFinding]:
        """Classify memory region for injection type."""
        injection_type = InjectionType.NONE
        severity = "LOW"
        details = {}
        
        # Check for RWX pages (highly suspicious)
        if region.is_executable and region.is_writable:
            injection_type = InjectionType.CODE_INJECTION
            severity = "CRITICAL"
            details['reason'] = "RWX (Read-Write-Execute) memory region"
        
        # Check for high entropy (possible encrypted payload)
        elif region.entropy > 0.9 and region.is_executable:
            injection_type = InjectionType.CODE_INJECTION
            severity = "HIGH"
            details['reason'] = "High entropy executable region (encrypted payload)"
            details['entropy'] = region.entropy
        
        # Check for suspicious patterns
        elif region.suspicious_patterns:
            injection_type = InjectionType.CODE_INJECTION
            severity = "HIGH"
            details['reason'] = "Suspicious code patterns detected"
            details['patterns'] = region.suspicious_patterns
        
        # Check for PE header in non-mapped memory
        elif "PE header" in str(region.suspicious_patterns) and not region.mapped_file:
            injection_type = InjectionType.REFLECTIVE_DLL
            severity = "CRITICAL"
            details['reason'] = "PE header in non-mapped memory (reflective DLL)"
        
        if injection_type != InjectionType.NONE:
            return InjectionFinding(
                finding_id=f"find_{hashlib.sha256(str(region.base_address).encode()).hexdigest()[:8]}",
                process_id=pid,
                process_name=self._get_process_name(pid),
                injection_type=injection_type,
                severity=severity,
                details=details,
                timestamp=datetime.now().timestamp(),
                memory_region=region
            )
        
        return None
    
    def _get_process_name(self, pid: int) -> str:
        """Get process name from PID."""
        try:
            with open(f"/proc/{pid}/comm") as f:
                return f.read().strip()
        except:
            return f"pid_{pid}"


class APIHookDetector:
    """
    Detects API hooking in processes.
    
    Checks:
  - Import Address Table (IAT) modifications
    - Export Address Table (EAT) modifications
    - Inline function hooks
    - VMT (Virtual Method Table) hooks
    """
    
    KNOWN_APIS = [
        'open', 'read', 'write', 'close',
        'socket', 'connect', 'send', 'recv',
        'malloc', 'free', 'execve', 'fork',
        'ptrace', 'process_vm_writev'
    ]
    
    def check_process(self, pid: int) -> List[InjectionFinding]:
        """Check process for API hooks."""
        findings = []
        
        # Check LD_PRELOAD (Linux equivalent of DLL injection)
        try:
            environ_path = f"/proc/{pid}/environ"
            if os.path.exists(environ_path):
                with open(environ_path, 'rb') as f:
                    env_data = f.read().decode(errors='ignore')
                    if 'LD_PRELOAD' in env_data:
                        findings.append(InjectionFinding(
                            finding_id=f"iat_{pid}",
                            process_id=pid,
                            process_name=self._get_process_name(pid),
                            injection_type=InjectionType.IAT_HOOKING,
                            severity="HIGH",
                            details={'reason': 'LD_PRELOAD detected', 'env': 'LD_PRELOAD'},
                            timestamp=datetime.now().timestamp(),
                            memory_region=None
                        ))
        except:
            pass
        
        # Check for LD_AUDIT
        try:
            environ_path = f"/proc/{pid}/environ"
            if os.path.exists(environ_path):
                with open(environ_path, 'rb') as f:
                    env_data = f.read().decode(errors='ignore')
                    if 'LD_AUDIT' in env_data:
                        findings.append(InjectionFinding(
                            finding_id=f"iat_audit_{pid}",
                            process_id=pid,
                            process_name=self._get_process_name(pid),
                            injection_type=InjectionType.IAT_HOOKING,
                            severity="MEDIUM",
                            details={'reason': 'LD_AUDIT detected', 'env': 'LD_AUDIT'},
                            timestamp=datetime.now().timestamp(),
                            memory_region=None
                        ))
        except:
            pass
        
        return findings
    
    def _get_process_name(self, pid: int) -> str:
        """Get process name."""
        try:
            with open(f"/proc/{pid}/comm") as f:
                return f.read().strip()
        except:
            return f"pid_{pid}"


class InjectionDetector:
    """
    Main injection detection engine.
    
    Combines multiple detection methods:
    - Memory analysis
    - API hook detection
    - Behavioral analysis
    - Heuristic detection
    """
    
    VERSION = "3.0.0"
    
    def __init__(self):
        self.data_dir = Path.home() / '.local' / 'share' / 'hive-inject'
        self.scan_history: List[InjectionFinding] = []
        self.whitelist: Set[str] = set()
        self.critical_processes: Set[str] = {
            'init', 'systemd', 'sshd', 'hive-ctrl',
            'hive-gateway', 'hive-orchestrator'
        }
        
        self.memory_analyzer = MemoryAnalyzer()
        self.hook_detector = APIHookDetector()
        
        self.stats = {
            'scans_performed': 0,
            'findings_detected': 0,
            'critical_injections': 0
        }
        
        self._ensure_dirs()
        self._load_whitelist()
    
    def _ensure_dirs(self):
        """Ensure data directories exist."""
        self.data_dir.mkdir(parents=True, exist_ok=True)
    
    def _load_whitelist(self):
        """Load whitelisted processes."""
        whitelist_file = self.data_dir / 'whitelist.txt'
        if whitelist_file.exists():
            self.whitelist = set(whitelist_file.read_text().strip().split('\n'))
    
    def scan_process(self, pid: int) -> List[InjectionFinding]:
        """Perform full scan on process."""
        findings = []
        
        # Skip whitelisted
        try:
            with open(f"/proc/{pid}/comm") as f:
                proc_name = f.read().strip()
            if proc_name in self.whitelist:
                return []
        except:
            return []
        
        print(f"[inject] Scanning PID {pid} ({proc_name})...")
        
        # Memory analysis
        mem_findings = self.memory_analyzer.analyze_process_memory(pid)
        findings.extend(mem_findings)
        
        # API hook detection
        hook_findings = self.hook_detector.check_process(pid)
        findings.extend(hook_findings)
        
        # Update stats
        self.stats['scans_performed'] += 1
        self.stats['findings_detected'] += len(findings)
        
        critical = sum(1 for f in findings if f.severity == 'CRITICAL')
        self.stats['critical_injections'] += critical
        
        self.scan_history.extend(findings)
        
        return findings
    
    def scan_all_processes(self) -> Dict[int, List[InjectionFinding]]:
        """Scan all accessible processes."""
        print("[inject] Scanning all processes...")
        
        results = {}
        
        try:
            for entry in os.listdir('/proc'):
                if entry.isdigit():
                    pid = int(entry)
                    findings = self.scan_process(pid)
                    if findings:
                        results[pid] = findings
        except PermissionError:
            print("[inject] Warning: Permission denied for some processes")
        
        print(f"\n[inject] Scan complete: {len(results)} processes with findings")
        return results
    
    def monitor_continuous(self, interval: int = 5):
        """Continuously monitor for injections."""
        print(f"[inject] Starting continuous monitoring (interval: {interval}s)")
        print("[inject] Press Ctrl+C to stop")
        
        known_injections: Set[str] = set()
        
        try:
            while True:
                results = self.scan_all_processes()
                
                for pid, findings in results.items():
                    for finding in findings:
                        finding_key = f"{finding.process_id}_{finding.injection_type.value}"
                        
                        if finding_key not in known_injections:
                            known_injections.add(finding_key)
                            self._alert(finding)
                
                time.sleep(interval)
                
        except KeyboardInterrupt:
            print("\n[inject] Monitoring stopped")
    
    def _alert(self, finding: InjectionFinding):
        """Generate alert for finding."""
        print("\n" + "=" * 60)
        print(f"INJECTION DETECTED - {finding.severity}")
        print("=" * 60)
        print(f"Process: {finding.process_name} (PID: {finding.process_id})")
        print(f"Type: {finding.injection_type.value}")
        print(f"Details: {finding.details.get('reason', 'Unknown')}")
        
        if finding.memory_region:
            print(f"Memory: 0x{finding.memory_region.base_address:x} "
                  f"({finding.memory_region.size} bytes)")
            print(f"Protection: {finding.memory_region.protection}")
        
        print("=" * 60)
        
        # Check if critical
        if finding.process_name in self.critical_processes:
            print("[CRITICAL] Hive process compromised!")
    
    def generate_report(self) -> str:
        """Generate detection report."""
        report = []
        report.append("=" * 70)
        report.append("PROCESS INJECTION DETECTION REPORT")
        report.append(f"Generated: {datetime.now().isoformat()}")
        report.append("=" * 70)
        report.append("")
        
        report.append("SUMMARY")
        report.append("-" * 70)
        report.append(f"Total scans: {self.stats['scans_performed']}")
        report.append(f"Total findings: {self.stats['findings_detected']}")
        report.append(f"Critical injections: {self.stats['critical_injections']}")
        report.append("")
        
        # Group by type
        by_type: Dict[str, int] = {}
        by_severity: Dict[str, int] = {}
        
        for finding in self.scan_history:
            t = finding.injection_type.value
            by_type[t] = by_type.get(t, 0) + 1
            
            s = finding.severity
            by_severity[s] = by_severity.get(s, 0) + 1
        
        report.append("FINDINGS BY TYPE")
        report.append("-" * 70)
        for t, count in sorted(by_type.items()):
            report.append(f"  {t}: {count}")
        report.append("")
        
        report.append("FINDINGS BY SEVERITY")
        report.append("-" * 70)
        for s in ['CRITICAL', 'HIGH', 'MEDIUM', 'LOW']:
            if s in by_severity:
                report.append(f"  {s}: {by_severity[s]}")
        report.append("")
        
        if self.scan_history:
            report.append("RECENT FINDINGS")
            report.append("-" * 70)
            for finding in self.scan_history[-10:]:
                report.append(f"  [{finding.severity}] {finding.process_name}: "
                            f"{finding.injection_type.value}")
        
        report.append("")
        report.append("=" * 70)
        
        return '\n'.join(report)
    
    def status(self):
        """Show detector status."""
        print(f"Process Injector Detector v{self.VERSION}")
        print(f"\nStatistics:")
        print(f"  Scans performed: {self.stats['scans_performed']}")
        print(f"  Findings detected: {self.stats['findings_detected']}")
        print(f"  Critical injections: {self.stats['critical_injections']}")
        print(f"\nWhitelist: {len(self.whitelist)} processes")
        print(f"Critical processes: {len(self.critical_processes)}")


def main():
    """CLI entry."""
    parser = argparse.ArgumentParser(prog='hive-inject')
    parser.add_argument('command',
                       choices=['scan', 'monitor', 'report', 'status',
                               'whitelist'])
    parser.add_argument('--pid', '-p', type=int, help='Target PID')
    parser.add_argument('--all', '-a', action='store_true',
                       help='Scan all processes')
    parser.add_argument('--interval', '-i', type=int, default=5,
                       help='Monitoring interval')
    
    args = parser.parse_args()
    
    detector = InjectionDetector()
    
    if args.command == 'scan':
        if args.pid:
            findings = detector.scan_process(args.pid)
            if findings:
                print(f"\nFound {len(findings)} injection artifacts:")
                for f in findings:
                    print(f"  [{f.severity}] {f.injection_type.value}")
            else:
                print("  No injection detected")
        elif args.all:
            detector.scan_all_processes()
        else:
            print("[inject] ERROR: --pid or --all required")
            return 1
    
    elif args.command == 'monitor':
        detector.monitor_continuous(args.interval)
    
    elif args.command == 'report':
        report = detector.generate_report()
        print(report)
    
    elif args.command == 'status':
        detector.status()
    
    elif args.command == 'whitelist':
        print(f"Whitelisted processes: {len(detector.whitelist)}")
        for proc in sorted(detector.whitelist):
            print(f"  {proc}")
    
    return 0


if __name__ == '__main__':
    import time
    sys.exit(main())
