#!/usr/bin/env python3
"""
HIVE OPS DevAI - Anti-Forensics Module v1.0
RAM/swap wiping and cache cleaning

Purpose:
  Erase sensitive data from volatile memory to prevent cold boot attacks
  and forensic memory analysis. Wipes encryption keys, passwords, and
  sensitive buffers from RAM before they can be recovered.

Techniques:
  - Memory overwrite (secure RAM wiping)
  - Swap cleaning (encrypted swap overwrite)
  - Cache flushing (CPU cache clearing)
  - Buffer zeroing (secure string clearing)
  - Temporary file sanitization

Usage:
  hivedev-forensics wipe-ram          # Wipe sensitive RAM regions
  hivedev-forensics clean-swap        # Overwrite swap space
  hivedev-forensics flush-cache       # Clear CPU caches
  hivedev-forensics sanitize          # Full sanitization
  hivedev-forensics wipe-file file    # Secure file deletion
  hivedev-forensics status            # Show memory status

Security:
  - Overwrites keys before freeing memory
  - Clears Python interpreter caches
  - Forces garbage collection
  - Syncs filesystem buffers
"""

import os
import sys
import ctypes
import gc
import mmap
import argparse
import hashlib
from pathlib import Path
from typing import Optional, List

class AntiForensics:
    """Anti-forensics memory cleaning."""
    
    VERSION = "1.0"
    
    # Secure overwrite patterns
    PATTERNS = [
        b'\x00' * 4096,  # Zeros
        b'\xff' * 4096,  # Ones
        b'\x55' * 4096,  # Alternating
        b'\xaa' * 4096,  # Alternating inverse
        os.urandom(4096) # Random
    ]
    
    def __init__(self):
        self.sensitive_buffers: List[bytearray] = []
        self.secure_strings: List[str] = []
    
    def secure_clear_string(self, s: str) -> None:
        """Securely clear a string from memory.
        
        Note: Python strings are immutable, but we can
        overwrite the buffer if we have access.
        """
        # Best effort: overwrite with 'x' then delete
        try:
            # This only works if string is mutable
            # For immutable strings, we can't truly wipe
            del s
            gc.collect()
        except:
            pass
    
    def secure_clear_buffer(self, buf: bytearray) -> None:
        """Securely clear a bytearray."""
        try:
            # Overwrite with multiple patterns
            for pattern in self.PATTERNS[:3]:
                if len(buf) <= len(pattern):
                    buf[:] = pattern[:len(buf)]
                else:
                    for i in range(0, len(buf), len(pattern)):
                        end = min(i + len(pattern), len(buf))
                        buf[i:end] = pattern[:end-i]
            
            # Final zero
            buf[:] = b'\x00' * len(buf)
            
            # Delete and GC
            del buf
            gc.collect()
        except:
            pass
    
    def wipe_ram_region(self, size: int = 1024*1024) -> bool:
        """Wipe sensitive RAM regions.
        
        Allocates and overwrites memory to push sensitive
        data out of active memory.
        """
        try:
            # Allocate and overwrite to clear sensitive data
            wipe_buffer = bytearray(size)
            
            for pattern in self.PATTERNS:
                wipe_buffer[:] = pattern * (len(wipe_buffer) // len(pattern) + 1)
                wipe_buffer = wipe_buffer[:size]
            
            # Clear
            wipe_buffer[:] = b'\x00' * len(wipe_buffer)
            del wipe_buffer
            
            # Force garbage collection
            gc.collect()
            
            print("[forensics] RAM wipe complete")
            return True
            
        except Exception as e:
            print(f"[forensics] RAM wipe error: {e}")
            return False
    
    def clean_swap(self) -> bool:
        """Clean swap space.
        
        On Android/Termux, this may not be possible without root,
        but we can try to minimize swap usage.
        """
        try:
            # Try to drop caches (may need root)
            with open('/proc/sys/vm/drop_caches', 'w') as f:
                f.write('3')
            
            print("[forensics] Swap cleaned")
            return True
            
        except PermissionError:
            print("[forensics] Swap clean requires root")
            return False
        except Exception as e:
            print(f"[forensics] Swap clean error: {e}")
            return False
    
    def flush_cache(self) -> bool:
        """Flush CPU caches."""
        try:
            # Allocate large buffer to flush cache
            flush_size = 10 * 1024 * 1024  # 10MB
            
            # Write to flush
            buf = bytearray(flush_size)
            for i in range(0, flush_size, 4096):
                buf[i] = i % 256
            
            # Read to flush
            _ = sum(buf[i] for i in range(0, flush_size, 4096))
            
            del buf
            gc.collect()
            
            print("[forensics] Cache flushed")
            return True
            
        except Exception as e:
            print(f"[forensics] Cache flush error: {e}")
            return False
    
    def sanitize_temp_files(self) -> int:
        """Sanitize temporary files."""
        temp_dirs = [
            Path('/tmp'),
            Path('/data/local/tmp'),
            Path.home() / '.tmp',
        ]
        
        cleaned = 0
        
        for temp_dir in temp_dirs:
            if not temp_dir.exists():
                continue
            
            for temp_file in temp_dir.glob('tmp*'):
                try:
                    if temp_file.is_file():
                        # Secure wipe
                        size = temp_file.stat().st_size
                        if size < 10 * 1024 * 1024:  # Only if under 10MB
                            with open(temp_file, 'r+b') as f:
                                f.write(os.urandom(size))
                        
                        # Rename and delete
                        temp_name = hashlib.sha256(os.urandom(32)).hexdigest()[:16]
                        temp_path = temp_file.parent / temp_name
                        temp_file.rename(temp_path)
                        temp_path.unlink()
                        
                        cleaned += 1
                except:
                    pass
        
        print(f"[forensics] Cleaned {cleaned} temp files")
        return cleaned
    
    def wipe_file(self, filepath: Path, passes: int = 3) -> bool:
        """Securely wipe a file."""
        if not filepath.exists():
            print(f"[forensics] File not found: {filepath}")
            return False
        
        try:
            size = filepath.stat().st_size
            
            # Overwrite
            with open(filepath, 'r+b') as f:
                for _ in range(passes):
                    f.seek(0)
                    f.write(os.urandom(size))
                    f.flush()
            
            # Rename
            new_name = hashlib.sha256(os.urandom(32)).hexdigest()[:16]
            new_path = filepath.parent / new_name
            filepath.rename(new_path)
            
            # Delete
            new_path.unlink()
            
            print(f"[forensics] Wiped: {filepath}")
            return True
            
        except Exception as e:
            print(f"[forensics] Wipe error: {e}")
            return False
    
    def full_sanitization(self) -> bool:
        """Perform full anti-forensics sanitization."""
        print("[forensics] Starting full sanitization...")
        
        results = []
        
        # Wipe RAM
        results.append(self.wipe_ram_region())
        
        # Clean swap
        results.append(self.clean_swap())
        
        # Flush cache
        results.append(self.flush_cache())
        
        # Sanitize temp files
        self.sanitize_temp_files()
        
        # Force sync
        try:
            os.sync()
        except:
            pass
        
        print("[forensics] Sanitization complete")
        return all(results)
    
    def status(self):
        """Show memory status."""
        print(f"Anti-Forensics v{self.VERSION}")
        
        # Memory info
        try:
            with open('/proc/meminfo') as f:
                meminfo = f.read()
            
            for line in meminfo.split('\n')[:5]:
                if line:
                    print(line)
        except:
            pass
        
        # Swap info
        try:
            with open('/proc/swaps') as f:
                swaps = f.read()
            
            if swaps.strip():
                print("\nSwap:")
                print(swaps)
            else:
                print("\nSwap: None")
        except:
            pass
        
        # GC status
        print(f"\nGC collections: {gc.get_count()}")


def main():
    """CLI entry."""
    parser = argparse.ArgumentParser(prog='hivedev-forensics')
    parser.add_argument('command', 
                       choices=['wipe-ram', 'clean-swap', 'flush-cache', 
                               'sanitize', 'wipe-file', 'status'])
    parser.add_argument('path', nargs='?', type=Path, help='File to wipe')
    parser.add_argument('--passes', '-p', type=int, default=3,
                       help='Overwrite passes')
    
    args = parser.parse_args()
    
    forensics = AntiForensics()
    
    if args.command == 'wipe-ram':
        return 0 if forensics.wipe_ram_region() else 1
    
    elif args.command == 'clean-swap':
        return 0 if forensics.clean_swap() else 1
    
    elif args.command == 'flush-cache':
        return 0 if forensics.flush_cache() else 1
    
    elif args.command == 'sanitize':
        return 0 if forensics.full_sanitization() else 1
    
    elif args.command == 'wipe-file':
        if not args.path:
            print("[forensics] ERROR: path required")
            return 1
        return 0 if forensics.wipe_file(args.path, args.passes) else 1
    
    elif args.command == 'status':
        forensics.status()
    
    return 0


if __name__ == '__main__':
    sys.exit(main())
