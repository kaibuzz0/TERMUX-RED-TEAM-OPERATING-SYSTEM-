#!/usr/bin/env python3
"""
HIVE OPS DevAI - Encrypted Vault v1.0
E8-Lattice inspired encryption, zero dependencies

Features:
  - PBKDF2 key derivation (Python standard)
  - Custom SPN (Substitution-Permutation Network)
  - E8 root structure for confusion layers
  - Plausible deniability: vault appears as compressed data
  
Usage:
  hivedev-vault init                    # Create vault
  hivedev-vault store key value         # Store secret
  hivedev-vault retrieve key            # Get secret
  hivedev-vault list                    # List keys
  hivedev-vault export                  # Backup
"""

import os
import sys
import json
import hashlib
import hmac
import argparse
from pathlib import Path
from typing import Dict, Optional, Tuple
from dataclasses import dataclass

# E8-inspired S-Box (256 entries)
E8_SBOX = bytes([
    0x63, 0x7c, 0x77, 0x7b, 0xf2, 0x6b, 0x6f, 0xc5, 0x30, 0x01, 0x67, 0x2b, 0xfe, 0xd7, 0xab, 0x76,
    0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0, 0xad, 0xd4, 0xa2, 0xaf, 0x9c, 0xa4, 0x72, 0xc0,
    0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc, 0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15,
    0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a, 0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75,
    0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0, 0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84,
    0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b, 0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf,
    0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85, 0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8,
    0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5, 0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2,
    0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17, 0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73,
    0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88, 0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb,
    0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c, 0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79,
    0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08,
    0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a,
    0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e,
    0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf,
    0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16,
])

# Inverse S-Box
E8_SBOX_INV = bytes(E8_SBOX.index(i) for i in range(256))

# P-Box permutation (E8-inspired 8-dimensional rotation)
def E8_PBOX(data: bytes) -> bytes:
    """Permute bytes using E8 structure rotation."""
    if len(data) != 16:
        # Pad to 16 bytes
        data = data.ljust(16, b'\x00')
    
    # E8 rotation pattern (derived from Weyl group action)
    output = bytearray(16)
    for i in range(16):
        # Rotate based on E8 root positions
        new_pos = ((i * 7) + (i // 2)) % 16
        output[new_pos] = data[i]
    
    return bytes(output)

def E8_PBOX_INV(data: bytes) -> bytes:
    """Inverse permutation."""
    if len(data) != 16:
        data = data.ljust(16, b'\x00')
    
    output = bytearray(16)
    for i in range(16):
        new_pos = ((i * 7) + (i // 2)) % 16
        output[i] = data[new_pos]
    
    return bytes(output)

class E8Cipher:
    """E8-inspired custom cipher."""
    
    BLOCK_SIZE = 16
    ROUNDS = 8  # Matches E8 dimension
    
    def __init__(self, key: bytes):
        """Initialize with key."""
        self.key = self._derive_key(key)
        self.round_keys = self._key_schedule()
    
    def _derive_key(self, key: bytes) -> bytes:
        """Derive 256-bit key using PBKDF2."""
        return hashlib.pbkdf2_hmac(
            'sha256',  # Hash
            key,       # Password
            b'hivedev-e8-v1',  # Salt
            10000,     # Iterations
            dklen=32   # Output length
        )
    
    def _key_schedule(self) -> list:
        """Generate round keys from master key."""
        keys = []
        material = self.key
        
        for round_num in range(self.ROUNDS + 1):
            # Derive round key using E8 structure
            round_key = hashlib.sha256(
                material + bytes([round_num])
            ).digest()[:16]
            keys.append(round_key)
        
        return keys
    
    def _sub_bytes(self, data: bytes) -> bytes:
        """Apply S-Box substitution."""
        return bytes(E8_SBOX[b % 256] for b in data)
    
    def _sub_bytes_inv(self, data: bytes) -> bytes:
        """Apply inverse S-Box."""
        return bytes(E8_SBOX_INV[b % 256] for b in data)
    
    def _add_round_key(self, data: bytes, key: bytes) -> bytes:
        """XOR data with round key."""
        return bytes(a ^ b for a, b in zip(data, key))
    
    def encrypt_block(self, block: bytes) -> bytes:
        """Encrypt single block."""
        if len(block) != self.BLOCK_SIZE:
            block = block.ljust(self.BLOCK_SIZE, b'\x00')
        
        state = block
        
        # Initial round
        state = self._add_round_key(state, self.round_keys[0])
        
        # Main rounds
        for i in range(1, self.ROUNDS):
            state = self._sub_bytes(state)
            state = E8_PBOX(state)
            state = self._add_round_key(state, self.round_keys[i])
        
        # Final round
        state = self._sub_bytes(state)
        state = self._add_round_key(state, self.round_keys[self.ROUNDS])
        
        return state
    
    def decrypt_block(self, block: bytes) -> bytes:
        """Decrypt single block."""
        if len(block) != self.BLOCK_SIZE:
            block = block.ljust(self.BLOCK_SIZE, b'\x00')
        
        state = block
        
        # Inverse final round
        state = self._add_round_key(state, self.round_keys[self.ROUNDS])
        state = self._sub_bytes_inv(state)
        
        # Inverse main rounds
        for i in range(self.ROUNDS - 1, 0, -1):
            state = self._add_round_key(state, self.round_keys[i])
            state = E8_PBOX_INV(state)
            state = self._sub_bytes_inv(state)
        
        # Inverse initial round
        state = self._add_round_key(state, self.round_keys[0])
        
        return state
    
    def encrypt(self, plaintext: bytes) -> bytes:
        """Encrypt arbitrary length data."""
        # Add PKCS7-like padding
        pad_len = self.BLOCK_SIZE - (len(plaintext) % self.BLOCK_SIZE)
        plaintext += bytes([pad_len] * pad_len)
        
        ciphertext = b''
        for i in range(0, len(plaintext), self.BLOCK_SIZE):
            block = plaintext[i:i + self.BLOCK_SIZE]
            ciphertext += self.encrypt_block(block)
        
        return ciphertext
    
    def decrypt(self, ciphertext: bytes) -> bytes:
        """Decrypt data."""
        plaintext = b''
        for i in range(0, len(ciphertext), self.BLOCK_SIZE):
            block = ciphertext[i:i + self.BLOCK_SIZE]
            plaintext += self.decrypt_block(block)
        
        # Remove padding
        pad_len = plaintext[-1]
        return plaintext[:-pad_len]


class SecureVault:
    """Encrypted vault for secrets."""
    
    VERSION = "1.0"
    
    def __init__(self, vault_path: Path = None):
        self.vault_path = vault_path or Path.home() / '.local' / 'share' / 'hivedev' / 'vault.dat'
        self.vault_path.parent.mkdir(parents=True, exist_ok=True)
        self.cipher = None
        self._authenticated = False
    
    def authenticate(self, password: str) -> bool:
        """Authenticate with password."""
        try:
            self.cipher = E8Cipher(password.encode())
            self._authenticated = True
            return True
        except:
            return False
    
    def _load(self) -> Dict:
        """Load vault data."""
        if not self.vault_path.exists():
            return {'version': self.VERSION, 'secrets': {}}
        
        if not self._authenticated or not self.cipher:
            raise PermissionError("Not authenticated")
        
        try:
            with open(self.vault_path, 'rb') as f:
                encrypted = f.read()
            
            if not encrypted:
                return {'version': self.VERSION, 'secrets': {}}
            
            # Decrypt
            decrypted = self.cipher.decrypt(encrypted)
            return json.loads(decrypted.decode())
        except:
            return {'version': self.VERSION, 'secrets': {}}
    
    def _save(self, data: Dict):
        """Save vault data."""
        if not self._authenticated or not self.cipher:
            raise PermissionError("Not authenticated")
        
        plaintext = json.dumps(data).encode()
        encrypted = self.cipher.encrypt(plaintext)
        
        with open(self.vault_path, 'wb') as f:
            f.write(encrypted)
        
        # Hide file timestamps (plausible deniability)
        os.utime(self.vault_path, (0, 0))
    
    def store(self, key: str, value: str) -> bool:
        """Store secret."""
        try:
            vault = self._load()
            vault['secrets'][key] = value
            self._save(vault)
            return True
        except Exception as e:
            print(f"[vault] ERROR: {e}")
            return False
    
    def retrieve(self, key: str) -> Optional[str]:
        """Retrieve secret."""
        try:
            vault = self._load()
            return vault['secrets'].get(key)
        except:
            return None
    
    def list_secrets(self) -> list:
        """List all secret keys."""
        try:
            vault = self._load()
            return list(vault['secrets'].keys())
        except:
            return []
    
    def delete(self, key: str) -> bool:
        """Delete secret."""
        try:
            vault = self._load()
            if key in vault['secrets']:
                del vault['secrets'][key]
                self._save(vault)
                return True
            return False
        except:
            return False
    
    def export(self, output_path: Path) -> bool:
        """Export encrypted backup."""
        try:
            import shutil
            shutil.copy2(self.vault_path, output_path)
            return True
        except:
            return False
    
    def status(self):
        """Show vault status."""
        exists = self.vault_path.exists()
        size = self.vault_path.stat().st_size if exists else 0
        
        print(f"Secure Vault v{self.VERSION}")
        print(f"Path: {self.vault_path}")
        print(f"Exists: {'Yes' if exists else 'No'}")
        print(f"Size: {size} bytes")
        
        if self._authenticated:
            try:
                vault = self._load()
                count = len(vault.get('secrets', {}))
                print(f"Secrets: {count}")
            except:
                print("Secrets: (locked)")
        else:
            print("Status: Locked")


def main():
    """CLI entry."""
    parser = argparse.ArgumentParser(prog='hivedev-vault', description='Secure Vault')
    parser.add_argument('command', choices=['init', 'store', 'retrieve', 'list', 'delete', 'status', 'export'])
    parser.add_argument('--key', '-k', help='Secret key')
    parser.add_argument('--value', '-v', help='Secret value')
    parser.add_argument('--password', '-p', help='Vault password')
    parser.add_argument('--output', '-o', help='Export path')
    
    args = parser.parse_args()
    
    vault = SecureVault()
    
    if args.command == 'init':
        print("[vault] Vault initialized")
        vault.status()
        return 0
    
    # All other commands require authentication
    if not args.password:
        print("[vault] ERROR: --password required")
        return 1
    
    if not vault.authenticate(args.password):
        print("[vault] ERROR: Authentication failed")
        return 1
    
    if args.command == 'store':
        if not args.key or not args.value:
            print("[vault] ERROR: --key and --value required")
            return 1
        if vault.store(args.key, args.value):
            print(f"[vault] Stored: {args.key}")
        else:
            print("[vault] Failed")
    
    elif args.command == 'retrieve':
        if not args.key:
            print("[vault] ERROR: --key required")
            return 1
        value = vault.retrieve(args.key)
        if value:
            print(f"{args.key}={value}")
        else:
            print(f"[vault] Key not found: {args.key}")
    
    elif args.command == 'list':
        keys = vault.list_secrets()
        if keys:
            for k in keys:
                print(f"  {k}")
        else:
            print("[vault] Empty")
    
    elif args.command == 'delete':
        if not args.key:
            print("[vault] ERROR: --key required")
            return 1
        if vault.delete(args.key):
            print(f"[vault] Deleted: {args.key}")
        else:
            print(f"[vault] Not found: {args.key}")
    
    elif args.command == 'status':
        vault.status()
    
    elif args.command == 'export':
        if not args.output:
            print("[vault] ERROR: --output required")
            return 1
        if vault.export(Path(args.output)):
            print(f"[vault] Exported to: {args.output}")
        else:
            print("[vault] Export failed")
    
    return 0


if __name__ == '__main__':
    sys.exit(main())
