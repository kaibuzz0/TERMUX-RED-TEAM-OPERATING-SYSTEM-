        "userfaultfd", "membarrier", "mlock2", "copy_file_range",
        "preadv2", "pwritev2", "pkey_mprotect", "pkey_alloc",
        "pkey_free", "statx", "io_pgetevents", "rseq"
    ]
    
    def generate_profile(self, container_name: str) -> Dict:
        """Generate default seccomp profile."""
        profile = {
            "defaultAction": "SCMP_ACT_ERRNO",
            "architectures": ["SCMP_ARCH_X86_64", "SCMP_ARCH_X86"],
            "syscalls": [
                {
                    "names": self.COMMON_SYSCALLS,
                    "action": "SCMP_ACT_ALLOW"
                }
            ]
        }
        
        return profile
    
    def save_profile(self, profile: Dict, output_path: Path):
        """Save seccomp profile to file."""
        output_path.write_text(json.dumps(profile, indent=2))
        print(f"[container] Seccomp profile saved: {output_path}")


class ContainerSecurity:
    """
    Main container security interface.
    """
    
    VERSION = "3.0.0"
    
    def __init__(self):
        self.image_scanner = ImageScanner()
        self.runtime_monitor = RuntimeSecurityMonitor()
        self.seccomp_generator = SeccompProfileGenerator()
        self.data_dir = Path.home() / '.local' / 'share' / 'hive-container'
        
        self._ensure_dirs()
    
    def _ensure_dirs(self):
        """Ensure directories exist."""
        self.data_dir.mkdir(parents=True, exist_ok=True)
    
    def scan_image(self, image_name: str) -> List[SecurityFinding]:
        """Scan container image."""
        return self.image_scanner.scan_image(image_name)
    
    def scan_container(self, container_id: str) -> List[SecurityFinding]:
        """Scan running container."""
        return self.runtime_monitor.analyze_container(container_id)
    
    def scan_all(self) -> Dict[str, List[SecurityFinding]]:
        """Scan all images and containers."""
        results = {}
        
        # Scan all containers
        container_results = self.runtime_monitor.scan_all_containers()
        results.update(container_results)
        
        return results
    
    def generate_seccomp(self, container_name: str, output: Optional[Path] = None):
        """Generate seccomp profile."""
        profile = self.seccomp_generator.generate_profile(container_name)
        
        if output is None:
            output = self.data_dir / f"{container_name}_seccomp.json"
        
        self.seccomp_generator.save_profile(profile, output)
    
    def generate_report(self) -> str:
        """Generate security report."""
        report = []
        report.append("=" * 70)
        report.append("CONTAINER SECURITY REPORT")
        report.append(f"Generated: {datetime.now().isoformat()}")
        report.append("=" * 70)
        report.append("")
        
        # Scan all
        results = self.scan_all()
        
        report.append("SUMMARY")
        report.append("-" * 70)
        
        total_findings = sum(len(f) for f in results.values())
        critical = sum(1 for findings in results.values()
                      for f in findings if f.severity == Severity.CRITICAL)
        high = sum(1 for findings in results.values()
                  for f in findings if f.severity == Severity.HIGH)
        
        report.append(f"Containers scanned: {len(results)}")
        report.append(f"Total findings: {total_findings}")
        report.append(f"Critical: {critical}")
        report.append(f"High: {high}")
        report.append("")
        
        if results:
            report.append("FINDINGS BY CONTAINER")
            report.append("-" * 70)
            
            for cid, findings in results.items():
                if findings:
                    report.append(f"\nContainer: {cid[:12]}")
                    for f in findings:
                        report.append(f"  [{f.severity.value.upper()}] {f.category}: {f.description}")
        
        report.append("")
        report.append("=" * 70)
        
        return '\n'.join(report)
    
    def status(self):
        """Show security status."""
        print(f"Container Security v{self.VERSION}")
        print("\nCapabilities:")
        print("  - Image vulnerability scanning")
        print("  - Runtime security monitoring")
        print("  - Seccomp profile generation")
        print("  - Hardening recommendations")
        print("  - CIS compliance checking")


def main():
    """CLI entry."""
    parser = argparse.ArgumentParser(prog='hive-container')
    parser.add_argument('command',
                       choices=['scan', 'monitor', 'profile', 'report',
                               'ls', 'status'])
    parser.add_argument('--image', '-i', help='Image to scan')
    parser.add_argument('--container', '-c', help='Container ID')
    parser.add_argument('--output', '-o', type=Path, help='Output file')
    
    args = parser.parse_args()
    
    security = ContainerSecurity()
    
    if args.command == 'scan':
        if args.image:
            findings = security.scan_image(args.image)
            print(f"\nFound {len(findings)} issues:")
            for f in findings:
                print(f"  [{f.severity.value.upper()}] {f.description}")
        elif args.container:
            findings = security.scan_container(args.container)
            print(f"\nFound {len(findings)} issues:")
            for f in findings:
                print(f"  [{f.severity.value.upper()}] {f.description}")
        else:
            print("[container] ERROR: --image or --container required")
            return 1
    
    elif args.command == 'monitor':
        results = security.scan_all()
        print(f"Monitoring complete: {len(results)} containers with issues")
    
    elif args.command == 'profile':
        name = args.container or 'default'
        security.generate_seccomp(name, args.output)
    
    elif args.command == 'report':
        report = security.generate_report()
        print(report)
    
    elif args.command == 'ls':
        try:
            result = subprocess.run(
                ['docker', 'ps', '--format', '{{.ID}} {{.Image}} {{.Status}}'],
                capture_output=True, text=True
            )
            if result.returncode == 0:
                print("Running Containers:")
                for line in result.stdout.strip().split('\n'):
                    if line:
                        print(f"  {line}")
        except:
            print("Docker not available")
    
    elif args.command == 'status':
        security.status()
    
    return 0


if __name__ == '__main__':
    sys.exit(main())
