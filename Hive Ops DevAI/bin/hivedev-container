#!/usr/bin/env python3
"""
HIVE OPS DevAI - Container Security v3.0
Docker/container isolation and hardening

Purpose:
  Comprehensive container security tool for Docker and containerd
  that provides hardening, isolation, vulnerability scanning, and
  runtime protection. Secures containerized workloads against
  escape attacks, privilege escalation, and supply chain threats.

Security Features:
  - Container image vulnerability scanning
  - Runtime security monitoring
  - Seccomp profile generation
  - Capability dropping recommendations
  - Namespace isolation verification
  - Network policy enforcement
  - Volume mount security
  - Privilege escalation detection
  - Container escape prevention
  - Supply chain integrity

Hardening Checks:
  - Rootless container execution
  - Read-only root filesystem
  - Dropped capabilities (CAP_DROP)
  - Added capabilities (CAP_ADD restrictions)
  - Seccomp profiles
  - AppArmor/SELinux profiles
  - No new privileges (no_new_privs)
  - User namespace mapping
  - Resource limits (CPU/memory)
  - Security options validation

Attack Prevention:
  - Privileged container detection
  - Dangerous volume mounts (/var/run/docker.sock)
  - Kernel exploitation vectors
  - Container breakout attempts
  - Lateral movement detection

Usage:
  hive-container scan --image IMAGE    # Scan image vulnerabilities
  hive-container harden --file Dockerfile  # Harden Dockerfile
  hive-container runtime --monitor   # Monitor running containers
  hive-container profile --generate  # Generate seccomp profile
  hive-container check --container ID # Security check container
  hive-container policy --apply       # Apply security policies
  hive-container ls                   # List secure containers
  hive-container escape --test        # Test escape resistance

Compliance:
  - CIS Docker Benchmark
  - NIST Container Security Guide
  - DISA STIG for Containers

Author: Hive Ops DevAI
Version: 3.0.0
"""

import os
import sys
import json
import re
import subprocess
import argparse
import hashlib
from pathlib import Path
from typing import Optional, List, Dict, Tuple, Set
from dataclasses import dataclass, asdict
from datetime import datetime
from enum import Enum

class Severity(Enum):
    CRITICAL = "critical"
    HIGH = "high"
    MEDIUM = "medium"
    LOW = "low"
    INFO = "info"

class ContainerState(Enum):
    RUNNING = "running"
    STOPPED = "stopped"
    PAUSED = "paused"
    RESTARTING = "restarting"

@dataclass
class SecurityFinding:
    """Container security finding."""
    finding_id: str
    severity: Severity
    category: str
    description: str
    remediation: str
    container_id: Optional[str]
    image: Optional[str]
    timestamp: float

@dataclass
class ContainerConfig:
    """Container security configuration."""
    privileged: bool
    user: str
    capabilities: List[str]
    security_opts: List[str]
    readonly_rootfs: bool
    no_new_privs: bool
    network_mode: str
    pid_mode: str
    volumes: List[Dict]
    env_vars: Dict[str, str]

class ImageScanner:
    """
    Container image vulnerability scanner.
    
    Scans for:
    - Known CVEs in packages
    - Secrets/credentials
    - Malware signatures
    - Misconfigurations
    - Compliance violations
    """
    
    # Known vulnerable patterns
    VULNERABLE_PACKAGES = {
        'openssh': ['<8.0'],
        'openssl': ['<1.1.1'],
        'bash': ['<4.3'],
        'sudo': ['<1.8.20'],
    }
    
    DANGEROUS_IMAGES = [
        'latest',           # Mutable tag
        'alpine:latest',    # May have vulnerabilities
    ]
    
    def __init__(self):
        self.findings: List[SecurityFinding] = []
    
    def scan_image(self, image_name: str) -> List[SecurityFinding]:
        """Scan container image for vulnerabilities."""
        print(f"[container] Scanning image: {image_name}")
        
        findings = []
        
        # Check for dangerous tags
        if ':latest' in image_name or ':' not in image_name:
            findings.append(SecurityFinding(
                finding_id=f"img_{hashlib.sha256(image_name.encode()).hexdigest()[:8]}",
                severity=Severity.HIGH,
                category="Image Tag",
                description=f"Image uses mutable 'latest' tag: {image_name}",
                remediation="Use immutable digest or specific version tag",
                container_id=None,
                image=image_name,
                timestamp=datetime.now().timestamp()
            ))
        
        # Check image size (large images may contain bloat)
        size = self._get_image_size(image_name)
        if size and size > 1024 * 1024 * 1024:  # > 1GB
            findings.append(SecurityFinding(
                finding_id=f"size_{hashlib.sha256(image_name.encode()).hexdigest()[:8]}",
                severity=Severity.MEDIUM,
                category="Image Size",
                description=f"Image exceeds 1GB ({size / (1024**2):.0f} MB)",
                remediation="Remove unnecessary packages and layers",
                container_id=None,
                image=image_name,
                timestamp=datetime.now().timestamp()
            ))
        
        # Check for root user
        user = self._get_image_user(image_name)
        if user == 'root' or user is None:
            findings.append(SecurityFinding(
                finding_id=f"root_{hashlib.sha256(image_name.encode()).hexdigest()[:8]}",
                severity=Severity.HIGH,
                category="User Privilege",
                description="Image runs as root user",
                remediation="Add 'USER' directive to run as non-root",
                container_id=None,
                image=image_name,
                timestamp=datetime.now().timestamp()
            ))
        
        # Check Dockerfile directives
        dockerfile = self._get_dockerfile_analysis(image_name)
        if dockerfile:
            findings.extend(dockerfile)
        
        return findings
    
    def _get_image_size(self, image_name: str) -> Optional[int]:
        """Get image size in bytes."""
        try:
            result = subprocess.run(
                ['docker', 'inspect', '-f', '{{.Size}}', image_name],
                capture_output=True, text=True
            )
            if result.returncode == 0:
                return int(result.stdout.strip())
        except:
            pass
        return None
    
    def _get_image_user(self, image_name: str) -> Optional[str]:
        """Get image default user."""
        try:
            result = subprocess.run(
                ['docker', 'inspect', '-f', '{{.Config.User}}', image_name],
                capture_output=True, text=True
            )
            if result.returncode == 0:
                user = result.stdout.strip()
                return user if user else None
        except:
            pass
        return None
    
    def _get_dockerfile_analysis(self, image_name: str) -> List[SecurityFinding]:
        """Analyze image history (simulated Dockerfile analysis)."""
        findings = []
        
        try:
            result = subprocess.run(
                ['docker', 'history', '--no-trunc', image_name],
                capture_output=True, text=True
            )
            if result.returncode == 0:
                history = result.stdout.lower()
                
                # Check for secrets in layers
                secret_patterns = [
                    r'password\s*=\s*\S+',
                    r'secret\s*=\s*\S+',
                    r'token\s*=\s*\S+',
                    r'api[_-]?key\s*=\s*\S+',
                ]
                
                for pattern in secret_patterns:
                    if re.search(pattern, history):
                        findings.append(SecurityFinding(
                            finding_id=f"secret_{hashlib.sha256(image_name.encode()).hexdigest()[:8]}",
                            severity=Severity.CRITICAL,
                            category="Secrets",
                            description="Potential secret/credential in image history",
                            remediation="Remove secrets from image, use runtime injection",
                            container_id=None,
                            image=image_name,
                            timestamp=datetime.now().timestamp()
                        ))
                        break
        except:
            pass
        
        return findings


class RuntimeSecurityMonitor:
    """
    Container runtime security monitor.
    
    Monitors for:
  - Container escape attempts
    - Privilege escalation
    - Suspicious syscalls
    - Network anomalies
    - File system access violations
    """
    
    DANGEROUS_VOLUMES = [
        '/var/run/docker.sock',
        '/var/run/docker.pid',
        '/var/run/containerd.sock',
        '/etc/docker',
        '/root',
        '/boot',
        '/proc',
        '/sys',
    ]
    
    CRITICAL_CAPABILITIES = [
        'SYS_ADMIN',      # All admin privileges
        'SYS_PTRACE',     # Process debugging
        'SYS_MODULE',     # Kernel module loading
        'SYS_RAWIO',      # Raw I/O access
        'SYS_BOOT',       # Reboot capability
        'DAC_READ_SEARCH', # Bypass file read permissions
        'DAC_OVERRIDE',   # Bypass file permission checks
    ]
    
    def __init__(self):
        self.active_containers: Dict[str, Dict] = {}
        self.suspicious_events: List[Dict] = []
    
    def analyze_container(self, container_id: str) -> List[SecurityFinding]:
        """Analyze running container security."""
        print(f"[container] Analyzing container: {container_id[:12]}...")
        
        findings = []
        
        # Get container info
        try:
            result = subprocess.run(
                ['docker', 'inspect', container_id],
                capture_output=True, text=True
            )
            if result.returncode != 0:
                return findings
            
            info = json.loads(result.stdout)[0]
            config = info.get('Config', {})
            host_config = info.get('HostConfig', {})
            
            # Check privileged mode
            if host_config.get('Privileged', False):
                findings.append(SecurityFinding(
                    finding_id=f"priv_{container_id[:8]}",
                    severity=Severity.CRITICAL,
                    category="Privilege",
                    description="Container running in privileged mode",
                    remediation="Remove --privileged flag, use specific capabilities",
                    container_id=container_id,
                    image=config.get('Image', 'unknown'),
                    timestamp=datetime.now().timestamp()
                ))
            
            # Check dangerous volume mounts
            binds = host_config.get('Binds', [])
            for bind in binds:
                for dangerous in self.DANGEROUS_VOLUMES:
                    if dangerous in bind:
                        findings.append(SecurityFinding(
                            finding_id=f"vol_{container_id[:8]}",
                            severity=Severity.CRITICAL,
                            category="Volume Mount",
                            description=f"Dangerous volume mount: {bind}",
                            remediation=f"Remove mount for {dangerous}",
                            container_id=container_id,
                            image=config.get('Image', 'unknown'),
                            timestamp=datetime.now().timestamp()
                        ))
            
            # Check capabilities
            cap_add = host_config.get('CapAdd', [])
            for cap in cap_add:
                if cap.upper() in self.CRITICAL_CAPABILITIES:
                    findings.append(SecurityFinding(
                        finding_id=f"cap_{container_id[:8]}",
                        severity=Severity.HIGH,
                        category="Capabilities",
                        description=f"Dangerous capability added: {cap}",
                        remediation=f"Drop capability {cap}",
                        container_id=container_id,
                        image=config.get('Image', 'unknown'),
                        timestamp=datetime.now().timestamp()
                    ))
            
            # Check if running as root
            user = config.get('User', '')
            if not user or user == 'root':
                findings.append(SecurityFinding(
                    finding_id=f"user_{container_id[:8]}",
                    severity=Severity.HIGH,
                    category="User",
                    description="Container running as root",
                    remediation="Add --user flag or USER directive",
                    container_id=container_id,
                    image=config.get('Image', 'unknown'),
                    timestamp=datetime.now().timestamp()
                ))
            
            # Check network mode
            network_mode = host_config.get('NetworkMode', '')
            if network_mode == 'host':
                findings.append(SecurityFinding(
                    finding_id=f"net_{container_id[:8]}",
                    severity=Severity.HIGH,
                    category="Network",
                    description="Container using host network namespace",
                    remediation="Use bridge network or custom network",
                    container_id=container_id,
                    image=config.get('Image', 'unknown'),
                    timestamp=datetime.now().timestamp()
                ))
            
            # Check PID mode
            pid_mode = host_config.get('PidMode', '')
            if pid_mode == 'host':
                findings.append(SecurityFinding(
                    finding_id=f"pid_{container_id[:8]}",
                    severity=Severity.HIGH,
                    category="PID",
                    description="Container sharing host PID namespace",
                    remediation="Remove --pid=host flag",
                    container_id=container_id,
                    image=config.get('Image', 'unknown'),
                    timestamp=datetime.now().timestamp()
                ))
            
            # Check IPC mode
            ipc_mode = host_config.get('IpcMode', '')
            if ipc_mode == 'host':
                findings.append(SecurityFinding(
                    finding_id=f"ipc_{container_id[:8]}",
                    severity=Severity.MEDIUM,
                    category="IPC",
                    description="Container sharing host IPC namespace",
                    remediation="Remove --ipc=host flag",
                    container_id=container_id,
                    image=config.get('Image', 'unknown'),
                    timestamp=datetime.now().timestamp()
                ))
            
            # Check readonly rootfs
            if not host_config.get('ReadonlyRootfs', False):
                findings.append(SecurityFinding(
                    finding_id=f"ro_{container_id[:8]}",
                    severity=Severity.MEDIUM,
                    category="Filesystem",
                    description="Root filesystem is writable",
                    remediation="Add --read-only flag",
                    container_id=container_id,
                    image=config.get('Image', 'unknown'),
                    timestamp=datetime.now().timestamp()
                ))
            
            # Check no_new_privs
            security_opts = host_config.get('SecurityOpt', [])
            has_no_new_privs = any('no-new-privileges' in opt for opt in security_opts)
            if not has_no_new_privs:
                findings.append(SecurityFinding(
                    finding_id=f"nonewpriv_{container_id[:8]}",
                    severity=Severity.MEDIUM,
                    category="Privilege",
                    description="No-new-privileges not set",
                    remediation="Add --security-opt=no-new-privileges:true",
                    container_id=container_id,
                    image=config.get('Image', 'unknown'),
                    timestamp=datetime.now().timestamp()
                ))
        
        except Exception as e:
            print(f"[container] Error analyzing container: {e}")
        
        return findings
    
    def scan_all_containers(self) -> Dict[str, List[SecurityFinding]]:
        """Scan all running containers."""
        print("[container] Scanning all containers...")
        
        results = {}
        
        try:
            result = subprocess.run(
                ['docker', 'ps', '-q'],
                capture_output=True, text=True
            )
            if result.returncode == 0:
                container_ids = result.stdout.strip().split('\n')
                container_ids = [cid for cid in container_ids if cid]
                
                for cid in container_ids:
                    findings = self.analyze_container(cid)
                    if findings:
                        results[cid] = findings
        except Exception as e:
            print(f"[container] Error: {e}")
        
        return results
    
    def generate_hardened_command(self, container_id: str) -> str:
        """Generate hardened docker run command."""
        # This would analyze current container and suggest hardening
        cmd = [
            "docker run",
            "--detach",
            "--read-only",
            "--security-opt no-new-privileges:true",
            "--cap-drop ALL",
            "--cap-add NET_BIND_SERVICE",  # If needed
            "--user 1000:1000",
            "--network bridge",
            "--memory 512m",
            "--cpus 1.0",
            "--pids-limit 100",
        ]
        
        return ' \\\n  '.join(cmd)


